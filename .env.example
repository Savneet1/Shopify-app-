# ---------------------------------------------------------------------------
# Shopify app credentials (from the Partner/Dev Dashboard app you create).
# The Shopify CLI injects SHOPIFY_API_KEY / SHOPIFY_API_SECRET / SHOPIFY_APP_URL
# / SCOPES automatically during `shopify app dev`; set them here for
# non-CLI processes (tests, migrations, production).
# ---------------------------------------------------------------------------
SHOPIFY_API_KEY=your_client_id_here
SHOPIFY_API_SECRET=your_client_secret_here
SHOPIFY_APP_URL=https://localhost:3000
# Phase 1 requests NO access scopes. Managed install requires the field to
# exist; it may be empty. See shopify.app.toml -> [access_scopes] scopes = "".
SCOPES=

# ---------------------------------------------------------------------------
# Database — TWO roles by design (multi-tenant RLS requirement):
#   - app_runtime : NOSUPERUSER, NOBYPASSRLS. Used by the running app.
#                   All queries are subject to Row-Level Security.
#   - app_owner   : owns the schema, runs migrations. Never used at runtime.
# DATABASE_URL        -> runtime role (Prisma Client)
# DIRECT_DATABASE_URL -> owner role  (prisma migrate deploy)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://app_runtime:runtime_pw@127.0.0.1:5433/boostlike_dev?schema=public"
DIRECT_DATABASE_URL="postgresql://app_owner:owner_pw@127.0.0.1:5433/boostlike_dev?schema=public"

# Test databases (used by `npm test`)
TEST_DATABASE_URL="postgresql://app_runtime:runtime_pw@127.0.0.1:5433/boostlike_test?schema=public"
TEST_DIRECT_DATABASE_URL="postgresql://app_owner:owner_pw@127.0.0.1:5433/boostlike_test?schema=public"

# Background jobs (pg-boss, Phase 2)
# BOSS_DATABASE_URL defaults to DATABASE_URL (app_runtime); pg-boss lives in its
# own schema. WORKER_CONCURRENCY bounds the incremental worker.
# BOSS_DATABASE_URL="postgresql://app_runtime:runtime_pw@127.0.0.1:5433/boostlike_dev?schema=public"
BOSS_SCHEMA=pgboss
WORKER_CONCURRENCY=2

# Logging
LOG_LEVEL=info
NODE_ENV=development
